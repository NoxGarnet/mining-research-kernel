{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Route",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "id", "route_id", "revision", "project_id", "scope", "source_refs", "status", "question_id", "research_question_id", "hypothesis_id", "workflow_id", "method_id", "inputs", "expected_evidence", "assigned_role", "budget", "runs_used", "stop_conditions", "verification_gates", "outputs", "reservations", "write_set", "parent_route_id", "supersedes_route_id"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "Route"},
    "id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "minProperties": 1},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task_id": {"type": ["string", "null"], "minLength": 1},
    "claim_id": {"type": ["string", "null"], "minLength": 1},
    "parent_route_id": {"type": ["string", "null"], "minLength": 1},
    "supersedes_route_id": {"type": ["string", "null"], "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "research_question_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": ["string", "null"]},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "inputs": {"type": "array"},
    "expected_evidence": {"type": "array"},
    "assigned_role": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "active", "blocked", "completed", "failed", "cannot_verify", "superseded", "accepted", "rejected"]},
    "budget": {"type": "integer", "minimum": 1},
    "runs_used": {"type": "integer", "minimum": 0},
    "stop_conditions": {"type": "array"},
    "verification_gates": {"type": "array"},
    "write_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array"},
    "reservations": {"type": "array"},
    "stop_reason": {"type": ["string", "null"], "minLength": 1}
  }
}
