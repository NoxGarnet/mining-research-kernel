{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "task_id", "project_id", "workflow_id", "task_type", "maturity", "required_reads", "relevant_failures", "relevant_decisions", "documentation_required", "documentation_status", "allowed_tools", "execution_authorized", "routes", "verification_gates", "stop_conditions", "writeback_targets"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "TaskPacket"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "project_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "task_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "maturity": {"enum": ["established", "known_workflow", "exploratory"]},
    "state": {"enum": ["proposed", "ready", "running", "completed", "blocked", "failed"]},
    "required_reads": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "material_reads": {"type": "array", "items": {"type": "object", "required": ["asset_id", "evidence_refs", "locator", "registration_status", "locator_status", "content_status", "reading_status", "verification_status"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "locator": {"type": "object"}, "requested_locator": {"type": "object"}, "reading": {"type": "object"}, "asset_kind": {"type": ["string", "null"]}, "authority": {"type": ["string", "null"]}, "asset_status": {"type": ["string", "null"]}, "content_sha256": {"type": ["string", "null"]}, "registration_status": {"type": "string", "minLength": 1}, "locator_status": {"type": "string", "minLength": 1}, "content_status": {"type": "string", "minLength": 1}, "reading_status": {"type": "string", "minLength": 1}, "verification_status": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "material_gaps": {"type": "array", "items": {"type": "object", "required": ["asset_id", "reason", "next_action"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "review_status": {"type": "string", "minLength": 1},
    "review_record_ref": {"type": ["string", "null"], "minLength": 1},
    "research_judgment_status": {"type": "string", "minLength": 1},
    "completion_scope": {"type": "string", "minLength": 1},
    "recovered_decisions": {"type": "array", "items": {"type": "object"}},
    "refs": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}},
    "relevant_failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevant_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevant_cognition": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevant_failure_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevant_decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relevant_cognition_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "documentation_required": {"type": "boolean"},
    "documentation_status": {"enum": ["VERIFIED", "SYNTHETIC_VERIFIED", "CANNOT_VERIFY", "NOT_APPLICABLE"]},
    "documentation_result": {"type": ["object", "null"]},
    "citation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "execution_authorized": {"type": "boolean"},
    "authorization_scope": {"type": ["object", "null"]},
    "routes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gate_statuses": {"type": "object"},
    "capability_statuses": {"type": "object", "additionalProperties": {"type": "object", "required": ["capability_id", "available", "state", "reason", "resume_condition", "scope"], "properties": {"capability_id": {"type": "string", "minLength": 1}, "available": {"type": "boolean"}, "state": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "resume_condition": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "stop_conditions": {"type": "array", "items": {"type": ["string", "object"]}},
    "stop_reason": {"type": ["string", "null"], "minLength": 1},
    "resume_condition": {"type": ["string", "null"], "minLength": 1},
    "prohibitions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "writeback_targets": {"type": "object"},
    "max_runs": {"type": "integer", "minimum": 1},
    "runs_used": {"type": "integer", "minimum": 0},
    "runs_remaining": {"type": "integer", "minimum": 0},
    "execution_reservations": {"type": "array"},
    "operations": {"type": "object"},
    "route_budgets": {"type": "object"},
    "task_context": {"enum": ["production", "synthetic"]},
    "fixture_id": {},
    "input": {},
    "history": {"type": "array", "items": {"type": "object"}},
    "next_action": {"type": "object"},
    "historical_next_action": {"type": ["object", "null"]},
    "historical_capability_statuses": {"type": "object"},
    "current_capability_statuses": {"type": "object"},
    "current_next_action": {"type": "object"},
    "last_reservation": {"type": "object"},
    "last_run": {"type": "object"}
  }
}
