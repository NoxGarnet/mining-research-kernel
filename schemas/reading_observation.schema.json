{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mining-research-kernel/schemas/reading_observation.schema.json",
  "title": "Agent supplied reading observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "origin", "captured_at", "source", "reader", "passages", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "reading_observation"},
    "origin": {"enum": ["agent_supplied", "synthetic"]},
    "captured_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "doi", "url", "version", "source_kind", "source_sha256", "authority"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "doi": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$", "maxLength": 300}]},
        "url": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2048}]},
        "version": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 200}]},
        "source_kind": {"enum": ["local_pdf", "web_article", "local_text"]},
        "source_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "authority": {"enum": ["original_publication", "derived", "unknown"]}
      }
    },
    "reader": {
      "type": "object", "additionalProperties": false, "required": ["tool", "method"],
      "properties": {"tool": {"type": "string", "minLength": 1, "maxLength": 120}, "method": {"enum": ["text", "visual", "ocr", "mixed"]}}
    },
    "passages": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/passage"}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 34, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value", "start_page", "end_page"], "properties": {"kind": {"const": "pdf_pages"}, "value": {"type": "string", "minLength": 1, "maxLength": 300}, "start_page": {"type": "integer", "minimum": 1, "maximum": 100000}, "end_page": {"type": "integer", "minimum": 1, "maximum": 100000}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["section", "figure", "table", "lines"]}, "value": {"type": "string", "minLength": 1, "maxLength": 300}}}
      ]
    },
    "passage": {
      "type": "object", "additionalProperties": false, "required": ["locator", "status", "text_sha256", "excerpt", "limitations"],
      "properties": {
        "locator": {"$ref": "#/$defs/locator"},
        "status": {"enum": ["read", "unavailable"]},
        "text_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "excerpt": {"type": "string", "maxLength": 1000},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "read"}}, "required": ["status"]}, "then": {"properties": {"excerpt": {"minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]}, "then": {"properties": {"excerpt": {"maxLength": 0}, "text_sha256": {"const": null}}}}
      ]
    }
  }
}
